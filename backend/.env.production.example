DJANGO_SECRET_KEY=<generate-long-random-secret>
DEBUG=False
ALLOWED_HOSTS=apps.cmu.edu.ph,127.0.0.1

DB_ENGINE=mysql
DB_NAME=dfs_project
DB_USER=dfs_user
DB_PASSWORD=<strong-password>
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=<strong-root-password>
MYSQL_HOST_PORT=3307

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
DEFAULT_FROM_EMAIL=<from-email>

FRONTEND_URL=https://apps.cmu.edu.ph/digifile

PDF_COMPRESSION_ENABLED=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OCR_ENABLED=True
OCR_LANGUAGE=eng
OCR_MAX_PAGES=25
OCR_DPI=200
OCR_MIN_TEXT_LENGTH=50
DOCUMENT_TEXT_INDEX_CHAR_LIMIT=250000
AI_SUMMARY_MAX_CHARS=1200
AI_SUMMARY_MAX_SENTENCES=6
CHATBOT_EXCERPT_MAX_LENGTH=1500
