DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

DB_ENGINE=mysql
SQLITE_NAME=/data/db.sqlite3
DB_NAME=vpaa_digi_file
DB_USER=dfs_user
DB_PASSWORD=dfs_password
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST_PORT=3307

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

FRONTEND_URL=http://localhost:5173

# Temporary directory for admin backup downloads (optional).
# BACKUP_TEMP_DIR=/app/tmp/backups

# Lossless PDF compression on manual upload (pypdf).
PDF_COMPRESSION_ENABLED=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OCR_ENABLED=True
OCR_LANGUAGE=eng
OCR_MAX_PAGES=25
OCR_DPI=200
OCR_MIN_TEXT_LENGTH=50
DOCUMENT_TEXT_INDEX_CHAR_LIMIT=250000
AI_SUMMARY_MAX_CHARS=1200
AI_SUMMARY_MAX_SENTENCES=6
CHATBOT_EXCERPT_MAX_LENGTH=1500
